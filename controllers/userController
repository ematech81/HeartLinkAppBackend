const bcrypt = require('bcryptjs');
const User   = require('../models/User');
const { Like, Match } = require('../models/Match');
const Report = require('../models/Report');
const Post   = require('../models/Post');
const { validateMinAge } = require('../utils/age');

// ─────────────────────────────────────────────────────────────────────────────
// Shared: anonymize a user's account. Used by both self-service deletion
// (DELETE /api/users/me, below) and admin deletion (adminController.deleteUser).
//
// Design: keep the User document (as a scrubbed stub) rather than a hard
// delete, so Messages/Matches/Likes/Reports that reference this id via
// populate() keep resolving instead of leaving dangling references that
// crash other users' screens (getConversations, in particular, already had
// a confirmed crash path here). Posts are hard-deleted — nothing else
// references those, and there's no "other party's history" reason to keep
// them. email/phone are $unset (not set to null) because both carry a
// sparse unique index — setting them to null instead would collide with
// every other null-valued document under that index.
// ─────────────────────────────────────────────────────────────────────────────
exports.anonymizeUser = async (userId) => {
  await Post.deleteMany({ author: userId });

  await User.findByIdAndUpdate(userId, {
    $set: {
      name:           'Deleted User',
      bio:            '',
      profession:     null,
      religion:       null,
      city:           null,
      country:        null,
      interests:      [],
      profilePicture: null,
      photos:         [],
      introVideo:     null,
      pushToken:      null,
      pushTokens:     [],
      googleId:       null,
      blockedUsers:   [],
      location:       { type: 'Point', coordinates: [0, 0] },
      isActive:        false,
      isProfileHidden: true,
      isDeleted:       true,
      deletedAt:       new Date(),
    },
    $unset: { email: 1, phone: 1 },
  });
};

// ─────────────────────────────────────────────────────────────────────────────
// PUT /api/users/push-token
// Register the current device's Expo push token — adds to pushTokens
// (multi-device: a phone and a tablet, or a reinstall, can both stay
// registered) rather than overwriting a single field. $addToSet avoids
// storing the same token twice if a device re-registers.
// ─────────────────────────────────────────────────────────────────────────────
exports.savePushToken = async (req, res) => {
  try {
    const { pushToken } = req.body;
    if (!pushToken) {
      return res.status(400).json({ success: false, message: 'Push token is required.' });
    }
    await User.findByIdAndUpdate(req.user._id, { $addToSet: { pushTokens: pushToken } });
    console.log(`📲 [PushToken] Registered for ${req.user._id}`);
    res.status(200).json({ success: true });
  } catch (error) {
    console.error('❌ [PushToken] Error:', error.message);
    res.status(500).json({ success: false, message: 'Server error.' });
  }
};

// ─────────────────────────────────────────────────────────────────────────────
// DELETE /api/users/push-token
// Deregister this device's token — call on logout, so a shared/reset device
// stops receiving a now-logged-out user's notifications (and doesn't risk
// showing them to whoever logs in next on the same device).
// ─────────────────────────────────────────────────────────────────────────────
exports.removePushToken = async (req, res) => {
  try {
    const { pushToken } = req.body;
    if (!pushToken) {
      return res.status(400).json({ success: false, message: 'Push token is required.' });
    }
    await User.findByIdAndUpdate(req.user._id, { $pull: { pushTokens: pushToken } });
    console.log(`📲 [PushToken] Deregistered for ${req.user._id}`);
    res.status(200).json({ success: true });
  } catch (error) {
    console.error('❌ [RemovePushToken] Error:', error.message);
    res.status(500).json({ success: false, message: 'Server error.' });
  }
};





// ─────────────────────────────────────────────────────────────────────────────
// GET /api/users/search
// Search/discover users with filters
// ─────────────────────────────────────────────────────────────────────────────
exports.searchUsers = async (req, res) => {
  try {
    const {
      gender, city, country, profession,
      minAge, maxAge,
      page   = 1,
      limit  = 20,
      tab,           // 'nearby' | 'global'
      lat,           // GPS latitude
      lng,           // GPS longitude
      radius = 50,   // km radius (default 50km)
    } = req.query;
 
    console.log('🔍 [Search] Params:', req.query);

    const alreadyLiked   = await Like.find({ sender: req.user._id }).distinct('receiver');

    // Exclude both directions of blocking: people I blocked, and people who
    // blocked me — neither should be able to find the other in Discover.
    const iBlocked       = (req.user.blockedUsers || []).map((id) => id.toString());
    const blockedMe      = await User.find({ blockedUsers: req.user._id }).distinct('_id');
    const excludedIds    = [...new Set([...alreadyLiked, ...iBlocked, ...blockedMe].map(String))];

    // ── Base filter ───────────────────────────────────────────────────────────
    const filter = {
      _id:             { $ne: req.user._id, $nin: excludedIds },
      isActive:        true,
      isBanned:        false,
      isProfileHidden: false,
    };
 
    // ── Tab filter ────────────────────────────────────────────────────────────
    if (tab === 'top') {
      // Top Profiles: boosted users appear first; no hard filter so the tab is never empty
    } else if (tab === 'global') {
      // Global: users from different countries
      if (req.user.country) {
        filter.country = { $not: new RegExp(`^${req.user.country}$`, 'i') };
      }
    } else if (tab === 'nearby' && !lat) {
      // Nearby without GPS: same country fallback
      if (req.user.country) {
        filter.country = new RegExp(req.user.country, 'i');
      }
    }
 
    // ── Standard filters ──────────────────────────────────────────────────────
    if (gender)                     filter.gender           = gender;
    if (city)                       filter.city             = new RegExp(city, 'i');
    if (country)                    filter.country          = new RegExp(country, 'i');
    if (profession)                 filter.profession       = new RegExp(profession, 'i');
    if (req.query.relationshipType) filter.relationshipType = req.query.relationshipType;
    if (req.query.religion)         filter.religion         = new RegExp(req.query.religion, 'i');
    if (req.query.education)        filter.education        = new RegExp(req.query.education, 'i');
 
    // ── Age filter ────────────────────────────────────────────────────────────
    if (minAge || maxAge) {
      filter.dateOfBirth = {};
      if (maxAge) filter.dateOfBirth.$gte = new Date(Date.now() - maxAge * 365.25 * 86400000);
      if (minAge) filter.dateOfBirth.$lte = new Date(Date.now() - minAge * 365.25 * 86400000);
    }
 
    const skip  = (Number(page) - 1) * Number(limit);
    let users   = [];
    let total   = 0;
 
    // ── GPS-based nearby search ───────────────────────────────────────────────
    if (lat && lng && tab === 'nearby') {
      console.log(`📍 [Search] GPS nearby: ${lat}, ${lng} within ${radius}km`);
 
      const geoResults = await User.aggregate([
        {
          $geoNear: {
            near:          { type: 'Point', coordinates: [parseFloat(lng), parseFloat(lat)] },
            distanceField: 'distance',
            maxDistance:   Number(radius) * 1000, // km → meters
            spherical:     true,
            query:         filter,
          },
        },
        { $skip:  skip },
        { $limit: Number(limit) },
        {
          $project: {
            name: 1, dateOfBirth: 1, city: 1, country: 1,
            profession: 1, interests: 1, bio: 1, religion: 1,
            education: 1, profilePicture: 1, photos: 1, introVideo: 1,
            isOnline: 1, lookingFor: 1, isVerified: 1, distance: 1,
          },
        },
      ]);
 
      if (geoResults.length > 0) {
        users = geoResults.map((u) => ({
          ...u,
          distanceKm: u.distance ? `${(u.distance / 1000).toFixed(1)} km away` : null,
        }));
        total = await User.countDocuments(filter);
      } else {
        // GPS found nothing (users likely have no coordinates stored) — fall back to country-based search
        console.log(`📍 [Search] GPS returned 0 — falling back to country-based search`);
        const fallbackFilter = { ...filter };
        if (req.user.country) fallbackFilter.country = new RegExp(req.user.country, 'i');
        total = await User.countDocuments(fallbackFilter);
        users = await User.find(fallbackFilter)
          .select('name dateOfBirth city country profession interests bio religion education profilePicture photos introVideo isOnline lookingFor verificationBadge isVerified isBoosted boostExpiry')
          .skip(skip)
          .limit(Number(limit))
          .lean();
      }

    } else {
      // Standard query (top, global, default)
      const SELECT_FIELDS = 'name dateOfBirth city country profession interests bio religion education profilePicture photos introVideo isOnline lookingFor verificationBadge isVerified isBoosted boostExpiry';
      total = await User.countDocuments(filter);
      users = await User.find(filter)
        .select(SELECT_FIELDS)
        .sort(tab === 'top' ? { isBoosted: -1, boostExpiry: -1, createdAt: -1 } : {})
        .skip(skip)
        .limit(Number(limit))
        .lean();
    }
 
    console.log(`✅ [Search] Found ${users.length} users (tab: ${tab || 'none'}, page: ${page})`);
 
    res.status(200).json({
      success:    true,
      users,
      total,
      page:       Number(page),
      totalPages: Math.ceil(total / Number(limit)),
      hasMore:    skip + users.length < total,
    });
 
  } catch (error) {
    console.error('❌ [Search] Error:', error.message);
    res.status(500).json({ success: false, message: 'Server error.' });
  }
};



// ─────────────────────────────────────────────────────────────────────────────
// GET /api/users/:id
// Get a single user profile by ID
// ─────────────────────────────────────────────────────────────────────────────
exports.getUserById = async (req, res) => {
  try {
    const user = await User.findById(req.params.id)
      .select('-password -otp -otpExpires -resetPasswordToken -resetPasswordExpires');

    if (!user) {
      return res.status(404).json({ success: false, message: 'User not found.' });
    }
    if (user.isProfileHidden || user.isBanned) {
      return res.status(404).json({ success: false, message: 'User not found.' });
    }

    res.status(200).json({ success: true, user });
  } catch (error) {
    console.error('❌ [GetUser] Error:', error.message);
    res.status(500).json({ success: false, message: 'Server error.' });
  }
};

// findByIdAndUpdate below runs with runValidators:false — a previous fix
// attempt for an undiagnosed "silent failure" (see the comment on that
// option). Re-enabling schema-wide validators risks reintroducing whatever
// that was, with no live DB available here to verify against. This instead
// validates just the fields that carry real constraints (enums, ranges),
// reading the constraints straight off the User schema so they can never
// drift from it.
const ENUM_FIELDS = ['gender', 'relationshipType', 'lookingFor', 'education', 'drink', 'smoke'];

function validateProfileUpdates(updates) {
  for (const field of ENUM_FIELDS) {
    if (updates[field] === undefined) continue;
    const allowedValues = User.schema.path(field)?.enumValues;
    if (allowedValues?.length && !allowedValues.includes(updates[field])) {
      return `Invalid value for ${field}: must be one of ${allowedValues.join(', ')}.`;
    }
  }
  if (updates.height !== undefined) {
    const h = Number(updates.height);
    if (isNaN(h) || h < 100 || h > 250) return 'Height must be between 100 and 250 cm.';
  }
  if (updates.numberOfKids !== undefined) {
    const n = Number(updates.numberOfKids);
    if (isNaN(n) || n < 0) return 'Number of kids cannot be negative.';
  }
  if (updates.bio !== undefined && updates.bio.length > 500) {
    return 'Bio must be 500 characters or fewer.';
  }
  if (updates.photos !== undefined && Array.isArray(updates.photos) && updates.photos.length > 6) {
    return 'Maximum 6 photos allowed.';
  }
  return null;
}

// ─────────────────────────────────────────────────────────────────────────────
// PUT /api/users/profile
// Update own profile
// ─────────────────────────────────────────────────────────────────────────────
exports.updateProfile = async (req, res) => {
  try {
    const allowed = [
      'name', 'bio', 'profession', 'religion', 'interests',
      'city', 'country', 'isProfileHidden', 'lookingFor',
      'education', 'drink', 'smoke', 'height',
      'profilePicture', 'photos', 'introVideo', 'location',
      // Google profile-completion fields
      'gender', 'dateOfBirth', 'relationshipType',
      'numberOfKids', 'kidsAges', 'isProfileComplete',
    ];

    const updates = Object.fromEntries(
      Object.entries(req.body).filter(([k]) => allowed.includes(k))
    );

    const validationError = validateProfileUpdates(updates);
    if (validationError) {
      return res.status(400).json({ success: false, message: validationError });
    }

    // dateOfBirth reaches this endpoint via the Google-onboarding profile
    // completion step (see RegistrationScreen googleMode path) — same
    // server-side 18+ enforcement as regular /auth/register, otherwise a
    // Google sign-up could set any dateOfBirth with no age check at all.
    if (updates.dateOfBirth) {
      const ageError = validateMinAge(updates.dateOfBirth);
      if (ageError) return res.status(400).json({ success: false, message: ageError });
    }

    // Consent — Google-onboarding users go through the same agreement modal
    // client-side but never hit /auth/register, so this is where their
    // consent gets recorded. `agreedToTerms` is a trigger, not a stored
    // field: only the server-stamped timestamp is persisted.
    if (req.body.agreedToTerms === true) {
      updates.agreedToTermsAt = new Date();
    }

    console.log('📝 [UpdateProfile] Saving:', updates); // ← add this log

    const user = await User.findByIdAndUpdate(
      req.user._id,
      { $set: updates },   // ← use $set explicitly
      { new: true, runValidators: false }  // ← disable validators to prevent silent failures
    ).select('-password -otp -otpExpires');

    console.log('✅ [UpdateProfile] Saved introVideo:', user.introVideo); // ← verify

    res.status(200).json({ success: true, user });
  } catch (error) {
    console.error('❌ [UpdateProfile] Error:', error.message);
    res.status(500).json({ success: false, message: 'Server error.' });
  }
};

// ─────────────────────────────────────────────────────────────────────────────
// POST /api/users/:id/block
// Block a user — persists the block (was previously a no-op that only
// unmatched/unliked, so the blocked user could immediately reappear and
// re-match). Also unmatches + clears likes both ways, same as before.
// ─────────────────────────────────────────────────────────────────────────────
exports.blockUser = async (req, res) => {
  try {
    const targetId = req.params.id;
    if (targetId === req.user._id.toString()) {
      return res.status(400).json({ success: false, message: 'Cannot block yourself.' });
    }

    const target = await User.findById(targetId).select('_id');
    if (!target) {
      return res.status(404).json({ success: false, message: 'User not found.' });
    }

    // Persist the block
    await User.findByIdAndUpdate(req.user._id, { $addToSet: { blockedUsers: targetId } });

    // Remove any existing match between them
    await Match.deleteOne({ users: { $all: [req.user._id, targetId] } });

    // Remove likes between them (prevents a stale like from re-surfacing
    // this person in the other's "who liked you" list)
    await Like.deleteMany({
      $or: [
        { sender: req.user._id, receiver: targetId },
        { sender: targetId,     receiver: req.user._id },
      ],
    });

    res.status(200).json({ success: true, message: 'User blocked successfully.' });
  } catch (error) {
    console.error('❌ [BlockUser] Error:', error.message);
    res.status(500).json({ success: false, message: 'Server error.' });
  }
};

// ─────────────────────────────────────────────────────────────────────────────
