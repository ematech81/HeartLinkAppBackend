# Copy this file to .env and fill in real values.
# NEVER commit the real .env — see .gitignore.
#
# All values below that ever leaked (they were previously committed to this
# repo's git history) must be treated as compromised and rotated, even after
# copying this template — see the audit notes for 2026-08-24.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
FORCE_CONSOLE_OTP=true
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ─── BulkSMS Nigeria (OTP / SMS) ──────────────────────────────────────────────
SMS_PROVIDER=bulksms
BULKSMS_BASE_URL=https://www.bulksmsnigeria.com/api/v2
BULKSMS_API_TOKEN=
BULKSMS_SENDER_ID=HeartLink

# ─── Brevo (Email) ────────────────────────────────────────────────────────────
# BREVO_FROM_EMAIL must be a verified sender in your Brevo account, or sends
# will fail.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=HeartLink

# ─── OTP policy (shared by SMS OTP + email reset code) ───────────────────────
# Alphanumeric codes (e.g. "OT34K6") — see utils/otp.js.
OTP_EXPIRES_MINUTES=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Dev: '*' is fine. Production: set this to your real app/admin origin(s) —
# never '*' once NODE_ENV=production.
CLIENT_URL=*

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Cloudinary (media uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── KoraPay (Payments) ─────────────────────────────────────────────────────
# Use TEST keys (sk_test_.../pk_test_...) in development, LIVE keys only in
# production (set directly in Railway's env, never committed here).
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=

# ─── Shared KoraPay webhook router ───────────────────────────────────────────
# See ../korapay-webhook-router — payments for this and several other apps
# route through one shared webhook forwarder. This app's routing prefix is
# "HRT". Must match the value set on the router's own ROUTER_FORWARD_SECRET.
ROUTER_FORWARD_SECRET=
